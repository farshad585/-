# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Goftino Chat Widget ID (Auto-injected in Vercel or environment)
GOFTINO_WIDGET_ID=

# Email Configuration (Resend API) - Required in Vercel Environment Variables
# RESEND_API_KEY: Resend API Key (starts with re_..., e.g. re_123456789_...)
RESEND_API_KEY=
# RESEND_FROM_EMAIL: Sender address verified in Resend (e.g. آکادمی ۴۰ دروازه <noreply@40gates.ir> or onboarding@resend.dev)
RESEND_FROM_EMAIL=
# ADMIN_EMAIL: Admin notification receiver address (e.g. 40gates.main@gmail.com)
ADMIN_EMAIL=
# ADMIN_PASSWORD: Password for logging into the admin panel (/admin)
ADMIN_PASSWORD=
ADMIN_PHONE=
# ADMIN_TOTP_SECRET: (Optional) Base32 secret for Admin 2FA Authenticator app
ADMIN_TOTP_SECRET=

