# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Goftino Chat Widget ID (Auto-injected in Vercel or environment)
GOFTINO_WIDGET_ID=

# Email Configuration (Gmail SMTP) - Required in Vercel Environment Variables
# GMAIL_USER: Sender Gmail address (e.g. 40gates.main@gmail.com)
GMAIL_USER=
# GMAIL_APP_PASSWORD: 16-character Google App Password (generated from Google Account Security > 2-Step Verification > App passwords)
GMAIL_APP_PASSWORD=
# ADMIN_EMAIL: Admin notification receiver address (e.g. fmfarshad585@gmail.com)
ADMIN_EMAIL=
# ADMIN_PASSWORD: Password for logging into the admin panel (/admin)
ADMIN_PASSWORD=
ADMIN_PHONE=

# Supabase Configuration (Database & Settings Persistence)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
